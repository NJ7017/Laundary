{
  "name": "aurawash-laundry-platform",
  "version": "1.0.0",
  "description": "AuraWash Full-Stack Laundry Pickup & Delivery Platform with React and Local Database",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev",
    "d1:init": "wrangler d1 execute laundary-db --file=schema.sql --remote",
    "d1:init:local": "wrangler d1 execute laundary-db --file=schema.sql --local"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0",
    "wrangler": "^4.142.0"
  }
}
